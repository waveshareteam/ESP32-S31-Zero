menu "Example Configuration"

    config EXAMPLE_WIFI_SSID
        string "Wi-Fi SSID"
        default "myssid"

    config EXAMPLE_WIFI_PASSWORD
        string "Wi-Fi password"
        default "mypassword"

    config EXAMPLE_MAXIMUM_RETRY
        int "Maximum connection retries"
        range 1 100
        default 10

endmenu
